# Скопируйте в .env и при необходимости поменяйте. Реальные пароли и ключи в git не попадают.
POSTGRES_USER=eia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eia

# Для backend при запуске без Docker
DATABASE_URL=postgresql+psycopg://eia:change-me@localhost:5432/eia
CORS_ORIGINS=http://localhost:3000
MAX_TRANSCRIPT_CHARS=200000

# Для frontend: куда проксировать /api
BACKEND_URL=http://localhost:8000

# Появится в срезе 2 (AI-анализ). Ключ хранится только на сервере.
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MAX_COST_PER_SESSION_USD=1.00
